# Copy this file to .env.local and fill in your Supabase project values.
# Project Settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Push notifications (see PUSH_NOTIFICATIONS.md). This is the PUBLIC half of
# the VAPID keypair only — safe to expose in the browser. The private half
# goes into Supabase Edge Function secrets, never here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
