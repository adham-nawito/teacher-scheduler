# Copy this file to .env.local and fill in your Supabase project values.
# Project Settings -> API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Push notifications (see PUSH_NOTIFICATIONS.md). This is the PUBLIC half of
# the VAPID keypair only — safe to expose in the browser. The private half
# goes into Supabase Edge Function secrets, never here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Billing (see BILLING.md). All three of these are meant to be public —
# Paddle's client-side token, environment, and price id are all safe to
# expose in the browser by design. The webhook secret (PADDLE_WEBHOOK_SECRET)
# and Supabase service role key are server-only and do NOT belong here — see
# BILLING.md for where those actually go (Vercel env vars, never committed).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your-paddle-client-side-token
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_ID=your-paddle-price-id
